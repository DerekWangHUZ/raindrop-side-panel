{
  "name": "raindrop-side-panel",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "在 Chromium 侧边栏中浏览、搜索并快速保存 Raindrop.io 书签。",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test:unit": "node --test tests/verify.test.mjs tests/ui-contract.test.mjs",
    "test:ui": "vitest run",
    "test": "npm run test:unit && npm run test:ui"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.2.5",
    "@fontsource-variable/geist-mono": "^5.2.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.43.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/chrome": "^0.0.300",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^26.1.0",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.1.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.0"
  }
}
